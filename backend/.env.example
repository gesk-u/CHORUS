DATABASE_URL=postgresql+asyncpg://chorus:chorus@localhost:5432/chorus
# JSON list of origins allowed to call the API from the browser
CORS_ORIGINS=["http://localhost:3000"]
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Max cosine distance for an article to join an existing story (lower = stricter)
CLUSTER_DISTANCE_THRESHOLD=0.35
CLUSTER_WINDOW_HOURS=48
# How far back the home feed looks (168 = 1 week)
FEED_WINDOW_HOURS=168
INGEST_INTERVAL_MINUTES=10
