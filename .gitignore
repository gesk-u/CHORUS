# Repo-wide ignores. Folder-specific rules live in frontend/.gitignore and backend/.gitignore.

# Editors and IDEs
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Secrets and local config (commit .env.example files instead)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
